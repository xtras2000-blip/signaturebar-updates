{
  "schema_version": "1.0",
  "scene_id": "ch1_sc_010",
  "lines": [
    {
      "line_id": "ch1_sc_010_l01",
      "speaker": "system",
      "text_kr": "돌상 대여 박스, 답례품 스티커, 한복 소매의 풀기.",
      "emotion": "neutral"
    },
    {
      "line_id": "ch1_sc_010_l02",
      "speaker": "npc_mother_in_law",
      "text_kr": "대추는 홀수로 올려라. 그게 법도야.",
      "emotion": "neutral"
    },
    {
      "line_id": "ch1_sc_010_l03",
      "speaker": "player",
      "text_kr": "네, 어머니. …네.",
      "condition": { "stat": "mind", "op": "lt", "value": 30 },
      "emotion": "tired"
    },
    {
      "line_id": "ch1_sc_010_l04",
      "speaker": "player",
      "text_kr": "네, 어머니. 그렇게 할게요.",
      "condition": { "stat": "mind", "op": "gte", "value": 30 },
      "emotion": "neutral"
    },
    {
      "line_id": "ch1_sc_010_l05",
      "speaker": "npc_husband",
      "text_kr": "상은 내가 나를게. 당신은 애 옷 입혀.",
      "condition": { "stat": "husband_support", "op": "gte", "value": 60 },
      "emotion": "neutral"
    },
    {
      "line_id": "ch1_sc_010_l06",
      "speaker": "npc_husband",
      "text_kr": "나 뭐 하면 돼?",
      "condition": { "stat": "husband_support", "op": "lt", "value": 30 },
      "emotion": "neutral"
    },
    {
      "line_id": "ch1_sc_010_l07",
      "speaker": "npc_husband",
      "text_kr": "몇 시까지 가면 되지?",
      "condition": [
        { "stat": "husband_support", "op": "gte", "value": 30 },
        { "stat": "husband_support", "op": "lt", "value": 60 }
      ],
      "emotion": "neutral"
    },
    {
      "line_id": "ch1_sc_010_l08",
      "speaker": "child",
      "text_kr": "cry_discomfort",
      "condition": { "ctx": "seed", "eq": "sensitive" },
      "emotion": "tired"
    },
    {
      "line_id": "ch1_sc_010_l09",
