{
  "schema_version": "1.0",
  "scene_id": "ch1_sc_005",
  "lines": [
    {
      "line_id": "ch1_sc_005_l01",
      "speaker": "system",
      "text_kr": "커튼 틈으로 해가 든다. 몸이 이불 밖으로 나가지지 않는다.",
      "emotion": "hesitant"
    },
    {
      "line_id": "ch1_sc_005_l02",
      "speaker": "child",
      "text_kr": "cry_unknown",
      "emotion": "tired"
    },
    {
      "line_id": "ch1_sc_005_l03",
      "speaker": "player",
      "text_kr": "열까지. …다시 열까지.",
      "condition": { "stat": "mind", "op": "lt", "value": 30 },
      "emotion": "hesitant"
    },
    {
      "line_id": "ch1_sc_005_l04",
      "speaker": "player",
      "text_kr": "…열까지만 세고 일어나자.",
      "condition": { "stat": "mind", "op": "gte", "value": 30 },
      "emotion": "hesitant"
    },
    {
      "line_id": "ch1_sc_005_l05",
      "speaker": "system",
      "text_kr": "숫자는 열에서 다시 하나로 돌아온다.",
      "emotion": "hesitant"
    },
    {
      "line_id": "ch1_sc_005_l06",
      "speaker": "system",
      "text_kr": "부재중 없음. 마지막 통화는 사흘 전 택배였다.",
      "emotion": "hesitant"
    },
    {
      "line_id": "ch1_sc_005_l07",
      "speaker": "system",
      "text_kr": "남편 자리는 새벽에 이미 비어 있었다.",
      "condition": { "stat": "husband_support", "op": "lt", "value": 30 },
      "emotion": "hesitant"
    },
    {
      "line_id": "ch1_sc_005_l08",
      "speaker": "npc_husband",
      "text_kr": "(메시지) 오늘 일찍 갈게. 뭐 먹고 싶어?",
      "condition": { "stat": "husband_support", "op": "gte", "value": 60 },
      "emotion": "neutral"
    },
    {
      "line_id": "ch1_sc_005_l09",
      "speaker": "system",
      "text_kr": "휴대폰 화면이 어두워질 때까지 들고 있는다.",
      "condition": [
        { "stat": "husband_support", "op": "gte", "value": 30 },
        { "stat": "husband_support", "op": "lt", "value": 60 }
      ],
      "emotion": "hesitant"
    },
    {
      "line_id": "ch1_sc_005_l10",
      "speaker": "player",
      "text_kr": "…아무한테나, 아무 말이나.",
      "emotion": "hesitant"
    }
  ]
}
